{
  "name": "@cubertimer/scrambler",
  "version": "0.0.0",
  "description": "Random state scrambles for speedcubing puzzles, following the WCA method. Pure TypeScript, no dependency, works in React Native.",
  "keywords": [
    "speedcubing",
    "rubiks-cube",
    "scramble",
    "wca",
    "kociemba",
    "two-phase",
    "react-native"
  ],
  "license": "MIT",
  "author": "Ange-Raphael",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raph4-lsk/scrambler.git"
  },
  "homepage": "https://github.com/raph4-lsk/scrambler#readme",
  "bugs": {
    "url": "https://github.com/raph4-lsk/scrambler/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
